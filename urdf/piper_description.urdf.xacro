<?xml version="1.0"?>
<!-- A Piper-series arm on its own, for display:
       xacro piper_description.urdf.xacro model:=piper_x with_gripper:=true -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">
  <xacro:arg name="model" default="piper"/>
  <xacro:arg name="with_gripper" default="true"/>
  <xacro:include filename="$(find piper_sdk_description)/urdf/piper_arm.xacro"/>
  <xacro:piper_arm model="$(arg model)" with_gripper="$(arg with_gripper)"/>
</robot>
